{
  "name": "fundingsecured",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"tsx watch --env-file=.env.local server/index.ts\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "tsx watch --env-file=.env.local server/index.ts",
    "build": "tsc -b && vite build",
    "start": "tsx --env-file=.env.local server/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed-sources.ts",
    "replay:build": "tsx scripts/build-recorded-replay.ts",
    "scraper:run": "tsx scripts/collect-source.ts",
    "self-heal:demo": "tsx scripts/show-healing-proof.ts",
    "verify:nim": "tsx --env-file=.env.local scripts/verify-nim.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "latest",
    "compression": "^1.8.1",
    "date-fns": "latest",
    "date-fns-tz": "latest",
    "drizzle-orm": "latest",
    "express": "latest",
    "pg": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@types/compression": "^1.8.1",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/pg": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "drizzle-kit": "latest",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "tsx": "latest",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "latest",
    "vitest": "latest"
  }
}
